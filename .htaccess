# Security headers + clean URLs for Apache (Hostinger).
# Mirrors the settings in vercel.json so the site behaves the same on Hostinger.

<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'none'; base-uri 'none'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://script.google.com https://script.googleusercontent.com https://*.googletagmanager.com; worker-src 'self'; manifest-src 'self'; connect-src https://script.google.com https://script.googleusercontent.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Cache policy: HTML/CSS/JS must revalidate every visit so deploys show up
  # immediately (ETag/Last-Modified make this cheap — mostly 304 Not Modified).
  # Overrides Hostinger's default 7-day cache that made CSS changes appear stale.
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Images change rarely and are safe to cache for a week.
  <FilesMatch "\.(png|jpe?g|webp|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Clean URLs: serve /page for /page.html, and redirect .html -> extensionless
# (mirrors vercel.json "cleanUrls": true and "trailingSlash": false).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Policy forms moved into /policies/ (Sept 2026). 301 the old URLs — both the
  # clean "/motor" form and any legacy "/motor.html" — to the new location so
  # links already shared (Instagram / WhatsApp / QR) keep working.
  RewriteRule ^(enquiry|fire|guaranteed-returns|health|home|motor|personal-accident|shop|term|travel|workmen)(\.html)?/?$ /policies/$1 [R=301,L]

  # Redirect explicit .html requests to the extensionless URL (301).
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Internally serve the .html file for extensionless requests.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Ensure correct MIME types (usually set by server, included for safety).
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>
